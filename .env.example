# Database
DATABASE_URL=postgresql://puckhub:puckhub_dev@localhost:5432/puckhub

# Auth
AUTH_SECRET=change-me-to-a-random-secret
AUTH_URL=http://api.puckhub.localhost

# API
API_PORT=3001
VITE_API_URL=http://api.puckhub.localhost

# Admin
ADMIN_PORT=3000
VITE_WEB_URL=http://web.puckhub.localhost

# Auto-migrate on API startup (set to 'false' to disable)
AUTO_MIGRATE=true

# Uploads
UPLOAD_DIR=../../uploads

# Default admin user (created on first startup if no users exist)
DEFAULT_USER_EMAIL=admin@puckhub.local

# Demo mode (periodic demo reset)
DEMO_MODE=false
DEMO_RESET_CRON=0 4 * * *

# Email — two sender identities ("mailboxes"), each with its own SMTP account.
#   auth    → sign-in links and invitations        (login@puckhub.eu)
#   noreply → contact form, OTP codes, notifications (no-reply@puckhub.eu)
# If nothing below is set, emails are logged to the console instead of sent.

# Shared SMTP host — override per mailbox only if the accounts live on different servers
#EMAIL_SMTP_HOST=mail.your-provider.tld
#EMAIL_SMTP_PORT=587

# Mailbox: auth
#EMAIL_AUTH_SMTP_USER=login@puckhub.eu
#EMAIL_AUTH_SMTP_PASS=
#EMAIL_AUTH_FROM=PuckHub <login@puckhub.eu>

# Mailbox: noreply
#EMAIL_NOREPLY_SMTP_USER=no-reply@puckhub.eu
#EMAIL_NOREPLY_SMTP_PASS=
#EMAIL_NOREPLY_FROM=PuckHub <no-reply@puckhub.eu>

# Single-account fallback — used by any mailbox without its own user/pass
#EMAIL_SMTP_USER=
#EMAIL_SMTP_PASS=
#EMAIL_FROM=no-reply@puckhub.eu

# Deprecated: HTTP relay, only used when no SMTP host is configured.
# Rewrites the envelope sender, which is what causes the "on behalf of" notice.
#EMAIL_RELAY_URL=https://your-server.com/send-email.php
#EMAIL_RELAY_SECRET=

# Passkey / WebAuthn
PASSKEY_RP_ID=puckhub.localhost
PASSKEY_RP_NAME=PuckHub Admin
PASSKEY_ORIGIN=http://admin.puckhub.localhost

# Domain configuration
BASE_DOMAIN=puckhub.localhost
VITE_BASE_DOMAIN=puckhub.localhost
COOKIE_DOMAIN=puckhub.localhost
SUBDOMAIN_SUFFIX=.puckhub.localhost
TRUSTED_ORIGINS=http://admin.puckhub.localhost,http://platform.puckhub.localhost
BETTER_AUTH_BASE_URL=http://api.puckhub.localhost
CNAME_TARGET=sites.puckhub.localhost

# AI Recaps (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview

# S3-compatible backup storage (e.g. Hetzner Object Storage)
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BACKUP_BUCKET=puckhub-backups
BACKUP_CRON=0 2 * * *
